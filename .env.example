# =====================================================================
# Razorpay AI Revenue Recovery Agent — Environment Configuration
# =====================================================================

# Application Environment & Zero-Config Demo Mode
APP_ENV=development
DEMO_MODE=true
PORT=8000
HOST=0.0.0.0

# Optional: PostgreSQL Database URL
# If omitted or empty, the application automatically boots into in-memory simulation mode.
# Example: postgresql://recovery:password@localhost:5432/recovery_db
DATABASE_URL=

# Optional: Razorpay Test Credentials
# If omitted or empty, the application automatically boots into mock simulation provider mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
